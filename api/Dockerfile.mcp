# Opt-in API image including both MCP transports and the shared training helpers.
FROM node:22-alpine
RUN adduser -D -H -s /sbin/nologin coach
WORKDIR /app/api
COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=dev --omit=optional
COPY api/ ./
WORKDIR /app/mcp
COPY mcp/package.json mcp/package-lock.json ./
RUN npm ci --omit=dev
COPY mcp/src ./src
COPY frontend/package.json /app/frontend/package.json
COPY frontend/src/lib /app/frontend/src/lib
WORKDIR /app/api
ENV NODE_ENV=production PORT=3000 MCP_ENABLED=1 TZ=Europe/London
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget --spider -q http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server.js"]
